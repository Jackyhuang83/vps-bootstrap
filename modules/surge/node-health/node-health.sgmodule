#!name=节点体检 Beta
#!desc=三源出口核对/IP纯净度、三大AI Web/App/API分项、Google搜索、流媒体片库/地区/CDN及三网五次HTTP耗时与波动。
#!category=VPS Bootstrap
#!arguments=SHOW_IP:false
#!arguments-desc=启用后点击「检测设置」面板，每点一次切换到下一个已有手动策略组并保存；显示组名和当前选择，不需要通知。选好后，在该组里选哪个节点就检测哪个。也可在 Safari 打开 http://surge-node-health.invalid/ 点选组，并添加到主屏幕方便以后打开。SHOW_IP：true 显示完整出口 IP，false 隐藏部分 IP。三个检测面板分别点击刷新。平台为未登录初检，实际播放和对话仍需验证；三网为运营商站点 HTTP 耗时，可能受 CDN 影响。

# v0.1.0-beta.6 — settings are answered locally over HTTP; no MITM/server.
[Panel]
VB-Health-Settings-Entry = script-name=VB-Health-Settings-Entry,title="检测设置",content="每点一次切换到下一个已有手动策略组，无需通知\n网页选组：http://surge-node-health.invalid/",update-interval=1
VB-Health-IP = script-name=VB-Health-IP,title="IP 纯净度",content="首次请点击「检测设置」面板，切换到要检测的策略组",update-interval=-1
VB-Health-Unlock = script-name=VB-Health-Unlock,title="平台解锁初检",content="点击刷新；九个平台分项、状态与耗时，AI/API及片库/CDN分别报告",update-interval=-1
VB-Health-Latency = script-name=VB-Health-Latency,title="三网站点 HTTP 耗时",content="点击刷新；手机 → 节点 → 三网站点；每站5次及波动",update-interval=-1

[Script]
VB-Health-Settings-Entry = type=generic,timeout=5,script-path=https://raw.githubusercontent.com/Jackyhuang83/vps-bootstrap/feat/surge-node-health/modules/surge/node-health/settings.js?v=0.1.0-beta.6
VB-Health-IP = type=generic,timeout=30,script-path=https://raw.githubusercontent.com/Jackyhuang83/vps-bootstrap/feat/surge-node-health/modules/surge/node-health/node-health.js?v=0.1.0-beta.6,argument="mode=ip&showIP={{{SHOW_IP}}}"
VB-Health-Unlock = type=generic,timeout=30,script-path=https://raw.githubusercontent.com/Jackyhuang83/vps-bootstrap/feat/surge-node-health/modules/surge/node-health/node-health.js?v=0.1.0-beta.6,argument="mode=unlock&showIP={{{SHOW_IP}}}"
VB-Health-Latency = type=generic,timeout=30,script-path=https://raw.githubusercontent.com/Jackyhuang83/vps-bootstrap/feat/surge-node-health/modules/surge/node-health/node-health.js?v=0.1.0-beta.6,argument="mode=latency&showIP={{{SHOW_IP}}}"
VB-Health-Settings = type=http-request,pattern=^http://surge-node-health\.invalid(?::80)?(?:/|$),requires-body=true,max-size=4096,timeout=10,script-path=https://raw.githubusercontent.com/Jackyhuang83/vps-bootstrap/feat/surge-node-health/modules/surge/node-health/settings.js?v=0.1.0-beta.6

[Host]
# Reserved documentation address; settings.js answers before any upstream dial.
surge-node-health.invalid = 192.0.2.1

