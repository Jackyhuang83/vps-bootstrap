#!name=节点体检
#!desc=IP纯净度、平台解锁、广州三网延迟、入口落地查询。通过「检测设置」绑定已有策略组；排障记录仅在本机保留，可用 Safari 的本地页面读取和复制。
#!category=VPS Bootstrap

# v1.0.0 — settings are answered locally over HTTP; no MITM/server.
[General]
# Only the two local UI addresses use forced HTTP processing. No listener is opened.
tun-included-routes = %INSERT% 192.0.2.1/32
force-http-engine-hosts = %INSERT% surge-node-health.invalid:80, 192.0.2.1:80
always-raw-tcp-hosts = %INSERT% -surge-node-health.invalid:80, -192.0.2.1:80

[Panel]
VB-Health-Settings-Entry = script-name=VB-Health-Settings-Entry,title="检测设置",content="点按切换已有策略组",update-interval=1
VB-Health-IP = script-name=VB-Health-IP,title="IP 纯净度",content="首次请点击「检测设置」面板，切换到要检测的策略组",update-interval=-1
VB-Health-Unlock = script-name=VB-Health-Unlock,title="平台解锁检测",content="点击刷新 · 每个平台一行结果",update-interval=-1
VB-Health-Latency = script-name=VB-Health-Latency,title="广州三网延迟",content="广州电信：待检测\n广州联通：待检测\n广州移动：待检测",update-interval=-1
VB-Health-Path = script-name=VB-Health-Path,title="入口落地查询",content="公网 IP：待检测\n入口 IP：待检测\n落地 IP：待检测",update-interval=-1

[Script]
VB-Health-Settings-Entry = type=generic,timeout=5,script-path=https://raw.githubusercontent.com/Jackyhuang83/vps-bootstrap/surge-node-health-v1.0.0/modules/surge/node-health/settings.js?v=1.0.0
VB-Health-IP = type=generic,timeout=30,script-path=https://raw.githubusercontent.com/Jackyhuang83/vps-bootstrap/surge-node-health-v1.0.0/modules/surge/node-health/node-health.js?v=1.0.0,argument="mode=ip"
VB-Health-Unlock = type=generic,timeout=30,script-path=https://raw.githubusercontent.com/Jackyhuang83/vps-bootstrap/surge-node-health-v1.0.0/modules/surge/node-health/node-health.js?v=1.0.0,argument="mode=unlock"
VB-Health-Latency = type=generic,timeout=70,script-path=https://raw.githubusercontent.com/Jackyhuang83/vps-bootstrap/surge-node-health-v1.0.0/modules/surge/node-health/node-health.js?v=1.0.0,argument="mode=latency"
VB-Health-Path = type=generic,timeout=30,script-path=https://raw.githubusercontent.com/Jackyhuang83/vps-bootstrap/surge-node-health-v1.0.0/modules/surge/node-health/node-health.js?v=1.0.0,argument="mode=path"
VB-Health-Settings = type=http-request,pattern=^http://(?:surge-node-health\.invalid|192\.0\.2\.1)(?::80)?(?:/|$),requires-body=true,max-size=4096,timeout=10,script-path=https://raw.githubusercontent.com/Jackyhuang83/vps-bootstrap/surge-node-health-v1.0.0/modules/surge/node-health/settings.js?v=1.0.0

[Host]
# Reserved documentation address; settings.js answers before any upstream dial.
surge-node-health.invalid = 192.0.2.1


