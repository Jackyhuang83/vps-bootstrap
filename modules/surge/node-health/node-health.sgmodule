#!name=节点体检 Beta
#!desc=IP纯净度、ChatGPT/Gemini/Claude、Google、Netflix/Disney+/YouTube/myTV SUPER/TikTok 初检及三网HTTP耗时。
#!category=VPS Bootstrap
#!arguments=POLICY:填写常用节点选择组名称,SHOW_IP:false
#!arguments-desc=POLICY：首次填写你平时切换节点的手动策略组完整名称，以后在该组里选哪个节点就检测哪个；也支持直接填写节点名。SHOW_IP：true 显示完整出口 IP，false 隐藏部分 IP。三个面板分别点击刷新。平台为未登录初检，实际播放和对话仍需验证；三网为运营商站点 HTTP 耗时，可能受 CDN 影响。

# v0.1.0-beta.2 — no MITM, no rule changes, no background schedule.
[Panel]
VB-Health-IP = script-name=VB-Health-IP,title="IP 纯净度",content="点击刷新；先设置模块 POLICY 参数",update-interval=-1
VB-Health-Unlock = script-name=VB-Health-Unlock,title="平台解锁初检",content="点击刷新；三大 AI、Google、流媒体及 TikTok",update-interval=-1
VB-Health-Latency = script-name=VB-Health-Latency,title="三网站点 HTTP 耗时",content="点击刷新；手机 → 节点 → 三网站点",update-interval=-1

[Script]
VB-Health-IP = type=generic,timeout=25,script-path=https://raw.githubusercontent.com/Jackyhuang83/vps-bootstrap/feat/surge-node-health/modules/surge/node-health/node-health.js?v=0.1.0-beta.2,argument="mode=ip&showIP={{{SHOW_IP}}}&policy={{{POLICY}}}"
VB-Health-Unlock = type=generic,timeout=25,script-path=https://raw.githubusercontent.com/Jackyhuang83/vps-bootstrap/feat/surge-node-health/modules/surge/node-health/node-health.js?v=0.1.0-beta.2,argument="mode=unlock&showIP={{{SHOW_IP}}}&policy={{{POLICY}}}"
VB-Health-Latency = type=generic,timeout=25,script-path=https://raw.githubusercontent.com/Jackyhuang83/vps-bootstrap/feat/surge-node-health/modules/surge/node-health/node-health.js?v=0.1.0-beta.2,argument="mode=latency&showIP={{{SHOW_IP}}}&policy={{{POLICY}}}"
