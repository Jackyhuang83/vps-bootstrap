# Template only. Store real tokens in root-owned /etc/ci-watchdog/watchdog.env.
# NEVER commit this file after entering credentials.
CI_WATCHDOG_OWNER=Jackyhuang83
# discover: automatically include current and newly created repositories owned by this account.
CI_WATCHDOG_REPO_MODE=discover
CI_WATCHDOG_READ_TOKEN=REPLACE_ME_READ_ACTIONS_TOKEN

# github_issue: write read-only reports as comments on a subscribed issue.
# GitHub may not notify the owner for comments written using their own PAT.
# stdout: journalctl only (no push notification).
CI_WATCHDOG_NOTIFY=github_issue
CI_WATCHDOG_REPORT_REPO=Jackyhuang83/vps-bootstrap
CI_WATCHDOG_ISSUE_NUMBER=REPLACE_WITH_ISSUE_NUMBER
CI_WATCHDOG_NOTIFY_TOKEN=REPLACE_ME_ISSUES_WRITE_TOKEN

# Alternatively (after Telegram support is enabled):
# CI_WATCHDOG_NOTIFY=telegram
# CI_WATCHDOG_TELEGRAM_BOT_TOKEN=YOUR_BOT_TOKEN
# CI_WATCHDOG_TELEGRAM_CHAT_ID=YOUR_CHAT_ID
